# Copy to K8s Secret / ConfigMap. Do not commit real secrets.

# ----- Redis -----
REDIS_HOST=r-xxxxxxxx.redis.rds.aliyuncs.com
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_QUEUE_KEY=player:queue
REDIS_PATH_PREFIX=/head-cam

# ----- OSS (optional when NO_UPLOAD=1) -----
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_BUCKET=ss-oss-data-platform
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_OUTPUT_PREFIX=processed_data
OSS_OUTPUT_SUB=ego_human_data/head_cam

# ----- Local mounts (must match K8s volumeMounts) -----
HEAD_CAM_MOUNT=/head-data
ORIN_MOUNT=/orin-data
LOCAL_MOUNT_PATH=/head-data
LOCAL_OUTPUT_DIR=/cache
TEMP_DIR=/tmp

# ----- HTTP cache server -----
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_ENABLED=1

# ----- Cluster sticky (optional; default off) -----
# SVIEW_CLUSTER=1 enables job locks + owner reverse-proxy across pods.
# POD_IP is injected by K8s Downward API in cluster deploy; empty => "local".
SVIEW_CLUSTER=0
# POD_IP=
# POD_HTTP_PORT=8080
# SVIEW_LOCK_TTL_SEC=120

# ----- Behavior -----
NO_UPLOAD=1
LOG_LEVEL=INFO
# Local default: ./sview.log under cwd. In Docker/K8s use a mounted path, e.g. /cache/sview.log
LOG_FILE=sview.log
FFMPEG_PATH=ffmpeg
CPU_CONCURRENCY=2
CHUNK_FRAMES=150

# ----- Transcode resolution -----
# Keep source: SIZE=WIDTH=HEIGHT=0
# Square downscale: TRANSCODE_SIZE=720  (720x720)
# Rectangular: TRANSCODE_WIDTH=1280 TRANSCODE_HEIGHT=720  (SIZE must stay 0)
TRANSCODE_SIZE=0
TRANSCODE_WIDTH=0
TRANSCODE_HEIGHT=0

# ----- Transcode quality (used whenever ffmpeg re-encodes) -----
# CRF 0-51, higher = smaller / lower quality. Alias: TRANSCODE_CQ
TRANSCODE_CRF=35
TRANSCODE_BITRATE=2M
TRANSCODE_MAXRATE=3M
TRANSCODE_BUFSIZE=4M
TRANSCODE_PRESET=veryfast
# 1 = re-encode H.264 even when resolution unchanged (so CRF/bitrate apply)
# 0 = H.264 passthrough when no resize (fastest; quality knobs ignored)
TRANSCODE_FORCE_REENCODE=0

# ----- Progressive publish (边转边播 path A) -----
# Write frames/manifest into LOCAL_OUTPUT_DIR while building (NO_UPLOAD mode).
PROGRESSIVE_PUBLISH=1
# Refresh partial manifest every N frames (also on first + last).
PARTIAL_MANIFEST_EVERY=30
# Frontend / API: consider playable once this many frames exist.
PLAYABLE_MIN_FRAMES=30

# Orin JPEG→H264: frames per progressive encode chunk (smaller → earlier first frame).
ORIN_CHUNK_FRAMES=30

# ----- Orin ROS2 CompressedImage (JPEG) bags -----
# Map topic camera name -> SView channel (FR/FL/RR/RL).
# ORIN_CAMERA_MAP=left_camera:FL,right_camera:FR,head_camera:RR,torso_camera:RL
